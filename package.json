{
  "name": "dashup-connector",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm --filter @dashup/protocol --filter @dashup/connector test",
    "check-types": "pnpm -r build && pnpm --filter @dashup/protocol --filter @dashup/connector check-types"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "bufferutil",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "utf-8-validate",
      "node-pty"
    ]
  }
}
